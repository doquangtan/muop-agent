<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Máy chủ Mướp Agents chạy nền, tách khỏi app Flutter. Cài tại /Library/LaunchAgents bởi gói .pkg.
         Binary nằm trong bundle "Muop Agents Server.app" để quyền Ghi màn hình gắn đúng với bundle này. -->
    <key>Label</key>
    <string>vn.muop.agent-server</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Applications/Muop Agents Server.app/Contents/MacOS/muop-agent-server</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Tự khởi động lại khi thoát lỗi; thoát bình thường (Dừng máy chủ, nâng cấp) thì không -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>MUOP_WEB_DIR</key>
        <string>/Applications/Muop Agents Server.app/Contents/Resources/web</string>
    </dict>
    <key>StandardOutPath</key>
    <string>/Library/Logs/muop-agent/server.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/muop-agent/server.log</string>
</dict>
</plist>
