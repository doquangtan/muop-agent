import { Button, ComboBox, LineEdit, ScrollView, TextEdit } from "std-widgets.slint";
import { Palette } from "theme.slint";
import { SideRow, MessageItem, PlanItem } from "types.slint";
import { SideRowView, MessageView } from "widgets.slint";

export { Palette, SideRow, MessageItem, PlanItem }

export component AppWindow inherits Window {
    title: "Mướp Agent Monitor";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 360px;
    min-height: 520px;
    background: Palette.bg;
    default-font-size: 13px;

    // ── Dữ liệu từ Rust ──
    // Chỉ các mục trong vùng nhìn (và vùng đệm) được đưa vào; phần còn lại là spacer
    // Trạng thái cuộn: Rust đọc định kỳ (không dùng callback `changed` vì ScrollView không phát ra)
    out property <float> chat-offset: -chat.viewport-y / 1px;
    out property <float> chat-view-h: chat.visible-height / 1px;
    out property <float> chat-content-h: chat.viewport-height / 1px;   // tổng chiều cao thật sau layout
    out property <float> side-offset: -side-sv.viewport-y / 1px;
    out property <float> side-view-h: side-sv.visible-height / 1px;
    in property <[SideRow]> side-rows;
    in property <float> side-top;
    in property <float> side-bottom;
    in property <[MessageItem]> messages;
    in property <float> chat-top;
    in property <float> chat-bottom;
    in property <int> total-messages;
    in property <[PlanItem]> plans;
    in property <[string]> project-names;
    in property <[string]> group-names;
    in property <[string]> effort-names;
    in property <[string]> question-texts;
    in-out property <int> group-index: 0;
    in-out property <int> effort-index: 0;
    in-out property <int> new-project-index: 0;
    in-out property <string> draft;
    in-out property <string> search;
    in-out property <string> answer-draft;
    in property <string> header-title: "Cuộc trò chuyện mới";
    in property <string> header-meta;
    in property <string> context-text;
    in property <int> context-level: 0;   // 0 bình thường, 1 cảnh báo (≥70%), 2 nguy hiểm (≥90%)
    in property <string> status-text: "Đang kết nối…";
    in property <string> toast;
    in property <string> retry-text;
    in property <bool> connected: false;
    in property <bool> running: false;
    in property <bool> has-session: false;

    // ── Trạng thái giao diện ──
    in-out property <bool> sidebar-visible: true;
    // Cập nhật bằng callback thay vì binding để tránh vòng lặp binding với layout
    in-out property <bool> narrow: false;
    changed width => { root.narrow = self.width < 760px; }
    init => { root.narrow = self.width < 760px; }
    in-out property <int> feedback-plan: -1;
    in-out property <string> feedback-draft;
    in-out property <bool> details-open: false;
    in-out property <string> details-title;
    in-out property <[string]> details-lines;

    // ── Callback về Rust ──
    callback row-activate(string, string);   // kind, key
    callback row-add(string);                // project path
    callback new-chat();
    callback search-changed();
    callback theme-toggled();
    callback group-picked(int);
    callback effort-picked(int);
    callback send(string);
    callback stop();
    callback plan-action(int, string, string); // index, action (approve|reject|cancel), feedback
    callback answer-question(string);
    callback retry-cancel();

    // Rust tính vị trí cuộn (bám đáy, bù khi đo lại chiều cao) rồi đặt qua hàm này
    public function set-scroll(y: float) {
        chat.viewport-y = -y * 1px;
    }

    // Bố cục tuyệt đối (không dùng layout ở cấp cửa sổ) để tránh vòng lặp binding khi đổi kích thước.
    // Màn rộng: sidebar 300px bên trái. Màn hẹp: sidebar phủ toàn màn khi mở.
    // ── Sidebar ──
    Rectangle {
        visible: root.sidebar-visible;
            x: 0px;
            y: 0px;
            width: root.narrow ? root.width : 300px;
            height: root.height;
            background: Palette.panel;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Mướp Agent";
                        color: Palette.text;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.connected ? "● online" : "● offline";
                        color: root.connected ? Palette.ok : Palette.danger;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Button {
                        text: Palette.dark ? "☀" : "☾";
                        width: 36px;
                        clicked => { root.theme-toggled(); }
                    }
                }

                LineEdit {
                    placeholder-text: "Tìm conversation…";
                    text: root.search;
                    edited(t) => {
                        root.search = t;
                        root.search-changed();
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    ComboBox {
                        model: root.project-names;
                        current-index <=> root.new-project-index;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "+ Mới";
                        clicked => {
                            root.new-chat();
                            if root.narrow { root.sidebar-visible = false; }
                        }
                    }
                }

                side-sv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px;
                        Rectangle { height: root.side-top * 1px; }
                        for r in root.side-rows: VerticalLayout {
                            spacing: 0px;
                            SideRowView {
                                side: r;
                                activate => {
                                    root.row-activate(r.kind, r.key);
                                    if root.narrow && r.kind == "session" { root.sidebar-visible = false; }
                                }
                                add => { root.row-add(r.key); }
                            }
                            Rectangle { height: 2px; }
                        }
                        Rectangle { height: root.side-bottom * 1px; }
                    }
                }

                Text {
                    text: root.status-text;
                    color: Palette.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }

        // ── Vùng chính ──
        Rectangle {
            x: root.narrow ? 0px : 300px;
            y: 0px;
            width: root.width - self.x;
            height: root.height;
            visible: !(root.narrow && root.sidebar-visible);
            background: Palette.bg;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Header
                HorizontalLayout {
                    spacing: 10px;
                    if root.narrow: Button {
                        text: "☰";
                        width: 40px;
                        clicked => { root.sidebar-visible = true; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: root.header-title;
                            color: Palette.text;
                            font-size: 16px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.header-meta;
                            color: Palette.muted;
                            font-size: 11px;
                            overflow: elide;
                        }
                    }
                    if root.running: Text {
                        text: "● đang chạy";
                        color: Palette.ok;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.context-text != "": Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: root.context-level == 2 ? Palette.danger : (root.context-level == 1 ? Palette.warn : Palette.border);
                        background: Palette.panel-raised;
                        width: ctx-label.preferred-width + 16px;
                        ctx-label := Text {
                            text: root.context-text;
                            color: root.context-level == 2 ? Palette.danger : (root.context-level == 1 ? Palette.warn : Palette.muted);
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }

                if root.toast != "": Text {
                    text: root.toast;
                    color: Palette.warn;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                if root.retry-text != "": Rectangle {
                    background: Palette.panel-raised;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.warn;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Text {
                            text: root.retry-text;
                            color: Palette.warn;
                            font-size: 12px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        Button {
                            text: "Hủy gửi lại";
                            clicked => { root.retry-cancel(); }
                        }
                    }
                }

                // Khung chat
                chat := ScrollView {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding-left: 8px;
                        padding-right: 16px;
                        spacing: 0px;
                        Rectangle { height: root.chat-top * 1px; }
                        if root.total-messages == 0: Text {
                            text: root.has-session ? "Conversation chưa có tin nhắn." : "Nhập yêu cầu bên dưới để bắt đầu cuộc trò chuyện mới.";
                            color: Palette.muted;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                        for m in root.messages: MessageView {
                            item: m;
                            show-details(t, lines) => {
                                root.details-title = t;
                                root.details-lines = lines;
                                root.details-open = true;
                            }
                        }
                        Rectangle { height: root.chat-bottom * 1px; }
                    }
                }

                // Banner plan chờ duyệt
                for p[i] in root.plans: Rectangle {
                    background: Palette.accent-soft;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.accent;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            text: "📋 Kế hoạch chờ duyệt: " + p.title;
                            color: Palette.text;
                            font-size: 13px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        if p.summary != "": Text {
                            text: p.summary;
                            color: Palette.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                            max-height: 60px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Duyệt & chạy";
                                primary: true;
                                clicked => { root.plan-action(i, "approve", ""); }
                            }
                            if p.feedback: Button {
                                text: "Góp ý chỉnh sửa";
                                clicked => { root.feedback-plan = i; root.feedback-draft = ""; }
                            }
                            Button {
                                text: "Hủy kế hoạch";
                                clicked => { root.plan-action(i, "cancel", ""); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.feedback-plan == i: HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Góp ý để sửa kế hoạch";
                                text <=> root.feedback-draft;
                            }
                            Button {
                                text: "Gửi góp ý";
                                enabled: root.feedback-draft != "";
                                clicked => {
                                    root.plan-action(i, "reject", root.feedback-draft);
                                    root.feedback-plan = -1;
                                }
                            }
                        }
                    }
                }

                // Banner câu hỏi AI đang chờ trả lời
                if root.question-texts.length > 0: Rectangle {
                    background: Palette.panel-raised;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Palette.warn;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text {
                            text: "❓ Agent đang hỏi (" + root.question-texts.length + " câu)";
                            color: Palette.warn;
                            font-size: 13px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.question-texts[0];
                            color: Palette.text;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Nhập câu trả lời";
                                text <=> root.answer-draft;
                            }
                            Button {
                                text: "Trả lời";
                                primary: true;
                                enabled: root.answer-draft != "";
                                clicked => {
                                    root.answer-question(root.answer-draft);
                                    root.answer-draft = "";
                                }
                            }
                        }
                    }
                }

                // Composer
                Rectangle {
                    background: Palette.panel;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Palette.border;
                    min-height: 110px;
                    max-height: 240px;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            spacing: 8px;
                            ComboBox {
                                min-width: 120px;
                                max-width: 260px;
                                horizontal-stretch: 1;
                                model: root.group-names;
                                current-index <=> root.group-index;
                                selected(v) => { root.group-picked(self.current-index); }
                            }
                            if root.effort-names.length > 0: ComboBox {
                                width: 120px;
                                model: root.effort-names;
                                current-index <=> root.effort-index;
                                selected(v) => { root.effort-picked(self.current-index); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 10px;
                            TextEdit {
                                horizontal-stretch: 1;
                                text <=> root.draft;
                                placeholder-text: "Nhập yêu cầu cho agent…";
                                wrap: word-wrap;
                                font-size: 14px;
                            }
                            VerticalLayout {
                                width: 110px;
                                spacing: 8px;
                                Button {
                                    text: "Gửi";
                                    primary: true;
                                    enabled: !root.running && root.draft != "";
                                    clicked => { root.send(root.draft); }
                                }
                                Button {
                                    text: "Dừng";
                                    enabled: root.running;
                                    clicked => { root.stop(); }
                                }
                            }
                        }
                    }
                }
            }
        }

    // Dialog chi tiết (thao tác / tệp thay đổi)
    if root.details-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.details-open = false; }
        }

        Rectangle {
            width: min(560px, root.width - 40px);
            height: min(520px, root.height - 80px);
            background: Palette.panel;
            border-radius: 14px;
            border-width: 1px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: root.details-title;
                        color: Palette.text;
                        font-size: 15px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "Đóng";
                        clicked => { root.details-open = false; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 6px;
                        for line in root.details-lines: Text {
                            text: line;
                            color: Palette.text;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }
}
