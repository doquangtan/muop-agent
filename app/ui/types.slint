// Struct dùng chung giữa Rust và giao diện.

// Một dòng trong sidebar: kind = "project" | "session" | "empty"
export struct SideRow {
    kind: string,
    key: string,
    title: string,
    meta: string,
    running: bool,
    selected: bool,
    expanded: bool,
    claude: bool,
    count: int,
}

// Một mục trong khung chat: kind = "user" | "ai" | "thinking" | "error"
export struct MessageItem {
    idx: int,
    kind: string,
    text: string,
    tools: [string],
    files: [string],
}

// Plan chờ duyệt (Artifact .md có RequestFeedback)
export struct PlanItem {
    title: string,
    summary: string,
    feedback: bool,
}
