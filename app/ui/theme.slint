// Bảng màu — port từ lib/ui/theme/app_theme.dart (seed mặc định xanh Material 3).
// Rust đổi `dark` để chuyển theme; mọi màu khác tự suy ra.
import { Palette as StdPalette } from "std-widgets.slint";

export global Palette {
    in-out property <bool> dark: true;

    // Nút, ô nhập, combo của std-widgets theo cùng theme với app
    changed dark => { StdPalette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light; }

    out property <color> bg: dark ? #0e1014 : #f5f6f9;
    out property <color> panel: dark ? #161920 : #ffffff;
    out property <color> panel-raised: dark ? #1d212b : #eceef3;
    out property <color> border: dark ? #2a2f3c : #d7dbe4;
    out property <color> text: dark ? #e7e9ef : #1b1f2a;
    out property <color> muted: dark ? #8a91a3 : #6b7285;
    out property <color> accent: dark ? #7d9cff : #3a5bd9;
    out property <color> accent-soft: dark ? #7d9cff2e : #3a5bd921;
    out property <color> user-bubble: dark ? #2a3a60 : #dbe4ff;
    out property <color> ai-bubble: dark ? #181c24 : #ffffff;
    out property <color> ok: dark ? #5fd39a : #1f8a57;
    out property <color> warn: dark ? #f2b35e : #a86612;
    out property <color> danger: dark ? #ff6b6b : #c42b3a;
    out property <color> danger-soft: dark ? #3a1d22 : #fbe3e5;
    out property <color> claude: dark ? #f2b35e : #a86612;
}
