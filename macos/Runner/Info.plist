<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDisplayName</key>
	<string>Mướp Agents</string>
	<key>CFBundleName</key>
	<string>Mướp Agents</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<!-- Lý do truy cập thư mục: macOS dùng các chuỗi này khi hỏi quyền lần đầu (hộp thoại tự hiện, không cần vào Privacy & Security) -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>Mướp Agents đọc và sửa các project nằm trên Desktop.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>Mướp Agents đọc và sửa các project nằm trong Documents.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Mướp Agents đọc và sửa các project nằm trong Downloads.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>Mướp Agents đọc và sửa project nằm trên ổ đĩa ngoài (thư mục project của bạn).</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>Mướp Agents đọc và sửa project nằm trên ổ mạng.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
